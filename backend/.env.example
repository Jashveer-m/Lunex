# Required.
DATABASE_URL=postgres://postgres@localhost:5432/lunex?sslmode=disable
# Required. At least 32 bytes; generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-bytes

# Optional (defaults shown).
PORT=8080
# Unchanged from Phase 1: renaming it invalidates every access token in flight.
JWT_ISSUER=lifeos
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
LOGIN_RATE_LIMIT_BURST=10
# Run pending migrations on boot instead of via cmd/migrate.
AUTO_MIGRATE=false

# --- Phase 3: documents and retrieval ---------------------------------------
# Embeddings come from a local Ollama. Start it with `ollama serve` and pull the
# model once with `ollama pull nomic-embed-text`.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
# Must match the vector(n) column in migration 000003. Changing the model means
# a migration that changes the column and re-embeds every existing chunk:
# vectors from two models are not comparable.
EMBEDDING_DIMENSIONS=768
# Upload size ceiling, in bytes. Rejected before the file is read.
MAX_UPLOAD_BYTES=10485760
# How long one synchronous upload may spend extracting, chunking and embedding.
# It also sets the server's read/write timeout, since the response cannot
# outlive the socket.
DOCUMENT_PROCESS_TIMEOUT=2m
