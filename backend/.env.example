# Required.
DATABASE_URL=postgres://postgres@localhost:5432/lunex?sslmode=disable
# Required. At least 32 bytes; generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-bytes

# Optional (defaults shown).
PORT=8080
# Unchanged from Phase 1: renaming it invalidates every access token in flight.
JWT_ISSUER=lifeos
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
LOGIN_RATE_LIMIT_BURST=10
# Run pending migrations on boot instead of via cmd/migrate.
AUTO_MIGRATE=false

# --- Phase 3: documents and retrieval ---------------------------------------
# Embeddings come from a local Ollama. Start it with `ollama serve` and pull the
# model once with `ollama pull nomic-embed-text`.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
# Must match the vector(n) column in migration 000003. Changing the model means
# a migration that changes the column and re-embeds every existing chunk:
# vectors from two models are not comparable.
EMBEDDING_DIMENSIONS=768
# Upload size ceiling, in bytes. Rejected before the file is read.
MAX_UPLOAD_BYTES=10485760
# How long one synchronous upload may spend extracting, chunking and embedding.
# It also sets the server's read/write timeout, since the response cannot
# outlive the socket.
DOCUMENT_PROCESS_TIMEOUT=2m

# --- Phase 4: the AI assistant ----------------------------------------------
# The chat model comes from the same local Ollama as the embeddings. Pull it
# once with `ollama pull llama3.2:3b`.
CHAT_MODEL=llama3.2:3b
# How long one whole turn may take: route, retrieve, generate, persist -- and
# the memory and graph extractions and, when a message asks for flashcards, one
# generation. The API refuses to start if MEMORY_EXTRACT_TIMEOUT +
# GRAPH_EXTRACT_TIMEOUT + AGENT_TIMEOUT + STUDY_GENERATE_TIMEOUT is more than
# half of this. A local 3B model answering from five retrieved chunks is
# tens of seconds of honest work, and this also has to fit inside the server's
# write timeout or the stream would be cut at the socket.
CHAT_TIMEOUT=24m
# 0-2. Kept low: the assistant is quoting your own notes back at you, and
# creative rephrasing of a deadline is a bug.
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=1024
# 0-1. The retrieval floor for chat. Below it a chunk is never shown to the
# model, which is the main defence against an unrelated question coming back
# with a confident-looking citation. With nomic-embed-text, related prose scores
# ~0.6-0.8 and unrelated prose ~0.3-0.5.
CHAT_MIN_SIMILARITY=0.5

# --- Phase 5: the AI memory system ------------------------------------------
# Extraction is the writing half: after a substantial chat turn, a second model
# call reads the exchange and stores what is worth remembering. Retrieval (the
# reading half) is always on -- an assistant with no memories loses nothing by
# looking. Set this to false to keep the assistant using what it already knows
# without learning anything new; it halves the model work per turn.
MEMORY_EXTRACTION=true
# Which model extracts. Empty means CHAT_MODEL does it. A smaller model is a
# reasonable choice: this call reads and classifies, it does not converse.
MEMORY_MODEL=
# How long one extraction may take. This is the latency memory adds to the end
# of a chat turn: the answer is fully streamed before extraction starts, so what
# it delays is the `done` frame, not the reply. Must fit inside CHAT_TIMEOUT.
MEMORY_EXTRACT_TIMEOUT=180s
# 0-2. Near zero: extraction is a reading task, and a creatively rephrased
# "fact" about you is a fabrication.
MEMORY_TEMPERATURE=0.1
MEMORY_MAX_TOKENS=512
# 0-1. The retrieval floor for memories, tuned separately from
# CHAT_MIN_SIMILARITY and higher. A memory is one sentence rather than a
# paragraph, it reaches the model as a stated fact about you, and it is searched
# on every turn regardless of topic -- so the floor is the only thing keeping an
# old preference out of an unrelated conversation.
MEMORY_MIN_SIMILARITY=0.6
# Ask the model server to constrain extraction to well-formed JSON. Off,
# because it makes llama3.2:3b strictly worse -- it answers `{}` and then pads
# whitespace to the token limit. Worth turning on for a model with real
# structured-output support. See docs/decisions.md.
MEMORY_JSON_MODE=false

# --- Phase 6: the knowledge graph -------------------------------------------
# The writing half: after a substantial turn, a third model call reads the
# exchange for relationships between things. Node sync and the 1-hop lookup
# are always on.
GRAPH_EXTRACTION=true
GRAPH_MODEL=
GRAPH_EXTRACT_TIMEOUT=180s
GRAPH_TEMPERATURE=0.1
GRAPH_MAX_TOKENS=512
GRAPH_JSON_MODE=false

# --- Phase 7: tools and the action engine -----------------------------------
# The assistant's tools: a routing call decides whether a message needs one of
# sixteen tools; a search runs at once, a change is only proposed and waits for
# POST /api/v1/actions/{id}/approve. false is the Phase 6 assistant. The
# approval endpoints stay mounted either way.
AGENT_TOOLS=true
# Which model routes. Empty means CHAT_MODEL.
AGENT_MODEL=
# Bounds one routing decision. It is spent before the first token of the answer
# and counts against CHAT_TIMEOUT. Measured on a 2-thread laptop CPU: ~3s when
# Ollama's prompt cache holds the routing prompt, ~55s when it does not -- and
# 3m08s cold on a 2019 Intel Mac, because the prompt renders every offered tool
# and Phase 10a took that from thirteen to sixteen. Raise it on a slow machine;
# the symptom of it being too low is a turn that fails as "model unavailable".
AGENT_TIMEOUT=180s
AGENT_TEMPERATURE=0.1
AGENT_MAX_TOKENS=200

# --- Phase 10a: the study module --------------------------------------------
# Which model writes flashcards from a document. Empty means CHAT_MODEL. Unlike
# the extractions, a *bigger* model is the reasonable override here: what this
# call produces is read by a person, over and over, as a study aid.
STUDY_MODEL=
# Bounds one flashcard generation. Like the routing call it is spent before the
# first token -- the cards are written while the proposal is being prepared, so
# the user can read them before approving -- and it counts against CHAT_TIMEOUT.
STUDY_GENERATE_TIMEOUT=180s
# 0-2. Near zero: writing a card from a passage is a reading task, and a
# creatively rephrased answer is one the grounding check throws away anyway.
STUDY_TEMPERATURE=0.1
# Twenty short cards as JSON is around a thousand tokens. The cap is what stops
# a model that decided to explain the document from generating for a minute.
STUDY_MAX_TOKENS=1024
# Constrain generation to JSON. Off, for the reason MEMORY_JSON_MODE is off.
STUDY_JSON_MODE=false
